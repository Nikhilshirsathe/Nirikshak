# ══════════════════════════════════════════════════════════════════════════════
# Nirikshak AI — Environment Variables
# Copy this to .env and fill in your values.
# For Railway: set these via the Railway dashboard → Variables tab.
# ══════════════════════════════════════════════════════════════════════════════

# ── Backend ───────────────────────────────────────────────────────────────────

# Environment: "development" or "production"
APP_ENV=development

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000

# Supabase JWT verification secret
# Get from: Supabase Dashboard → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Groq LLM API key for AI chatbot and report generation
# Get from: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Model directory (relative to backend/ or absolute path)
MODEL_DIR=./Models

# Upload directory (relative to backend/ or absolute path)
UPLOAD_DIR=./data/uploads

# Maximum upload file size in MB
MAX_UPLOAD_SIZE_MB=150

# ── Frontend (must be prefixed with NEXT_PUBLIC_) ─────────────────────────────

# Backend API URL (Railway deployment URL)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here