# ══════════════════════════════════════════════════════════════════════════════
# Nirikshak AI Frontend — Environment Variables
# Copy to .env.local and fill in values.
# For Vercel: set these in the Vercel dashboard → Settings → Environment Variables
# ══════════════════════════════════════════════════════════════════════════════

# Backend API URL (your Railway deployment URL)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase project URL (from Supabase dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous/public key (from Supabase dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here